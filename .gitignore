# ============================================================
# MRD Personal Knowledge Assistant - .gitignore
# ============================================================

# ============================================================
# PYTHON
# ============================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*$py.class

# Python build / packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
wheelhouse/

# Python environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ============================================================
# ENVIRONMENT & SECRETS
# ============================================================
.env
.env.*
!.env.example

*.secret
*.secrets
secrets/
credentials/
credentials.json
secrets.json

# Certificates / private keys
*.pem
*.key
*.crt
*.p12
*.pfx

# ============================================================
# PERSONAL / PRIVATE DATA
# ============================================================
# Keep personal knowledge-base data out of Git.
data/resume/*
data/github/*
data/raw/*
data/private/*
data/personal/*
data/user_data/*

# Preserve directory structure
!data/resume/.gitkeep
!data/github/.gitkeep
!data/raw/.gitkeep
!data/private/.gitkeep
!data/personal/.gitkeep
!data/user_data/.gitkeep

# ============================================================
# RAG / VECTOR DATABASE / INDEXES
# ============================================================
# Generated FAISS/vector artifacts
*.faiss
*.index
*.pkl
*.pickle
*.npy
*.npz

data/index/
data/indexes/
data/vectorstore/
data/vectorstores/
data/embeddings/
data/processed/
data/cache/

# RAG metadata / generated files
*.metadata
*.meta
*.db
*.sqlite
*.sqlite3

# Preserve documentation
!data/README.md
!data/**/README.md

# ============================================================
# MACHINE LEARNING / MODEL CACHE
# ============================================================
.cache/
.cache-loader/

huggingface/
huggingface_cache/
transformers_cache/
torch_cache/
model_cache/
models/
checkpoints/
runs/

# Hugging Face
.huggingface/
*.safetensors
*.bin

# ============================================================
# OLLAMA / LOCAL MODEL DATA
# ============================================================
# Do not accidentally commit locally downloaded models
ollama/
ollama_models/
models/
*.gguf

# ============================================================
# LOGS
# ============================================================
*.log
logs/
log/
*.out

# ============================================================
# TEMPORARY FILES
# ============================================================
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo
*.orig
*~

# ============================================================
# TESTING / COVERAGE
# ============================================================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/

.coverage
.coverage.*
coverage.xml
htmlcov/
pytest-report.html

# ============================================================
# JUPYTER / NOTEBOOKS
# ============================================================
.ipynb_checkpoints/

# ============================================================
# FRONTEND - NODE / NEXT.JS / REACT
# ============================================================
node_modules/
frontend/node_modules/

.next/
frontend/.next/

out/
frontend/out/

dist/
frontend/dist/

build/
frontend/build/

# Vite
.vite/

# Next.js
.next/
.vercel/

# ============================================================
# FRONTEND ENVIRONMENT
# ============================================================
.env.local
.env.development.local
.env.test.local
.env.production.local

frontend/.env
frontend/.env.*
!frontend/.env.example

# ============================================================
# NPM / YARN / PNPM
# ============================================================
.npm/
.yarn/
.pnpm-store/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# IDE / EDITORS
# ============================================================
.vscode/
.idea/
.eclipse/
.fleet/

*.iml
*.ipr
*.iws

# VS Code local history
.history/

# ============================================================
# OS FILES
# ============================================================
.DS_Store
.DS_Store?
._*

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db

Desktop.ini

$RECYCLE.BIN/

# ============================================================
# WINDOWS
# ============================================================
*.lnk

# ============================================================
# MACOS
# ============================================================
.AppleDouble
.LSOverride

# ============================================================
# LINUX
# ============================================================
*~

# ============================================================
# DOCKER
# ============================================================
docker-compose.override.yml

# ============================================================
# LOCAL DEVELOPMENT
# ============================================================
.local/
.local_data/
runtime/
tmp/
temp/

# ============================================================
# GENERATED DOCUMENTATION / EXPORTS
# ============================================================
generated/
exports/
output/
outputs/

# ============================================================
# BACKUPS
# ============================================================
*.old
*.save
*.backup
*.orig

# ============================================================
# DATABASE / LOCAL STATE
# ============================================================
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# ============================================================
# DEBUG / PROFILING
# ============================================================
*.prof
*.profraw
*.pyprof
profile/
profiling/

# ============================================================
# LOCAL CONFIGURATION
# ============================================================
config.local.*
settings.local.*
local.config.*
local.settings.*

# ============================================================
# PROJECT-SPECIFIC GENERATED FILES
# ============================================================
# Generated indexes
index/
indexes/

# Generated chunks
chunks/
chunk_cache/

# Embedding caches
embedding_cache/

# Retrieval caches
retrieval_cache/

# API caches
api_cache/

# ============================================================
# KEEP IMPORTANT EXAMPLES / DOCUMENTATION
# ============================================================
!.gitkeep
!README.md
!**/README.md
!requirements.txt
!package.json
!package-lock.json
!pnpm-lock.yaml
!yarn.lock
!*.example
!*.sample